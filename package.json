{
  "name": "inversify-typeorm",
  "version": "1.0.0",
  "description": "Dependency injection and service container integration with TypeORM using InversifyJs library.",
  "author": "felicityin <yinjingping2022@gmail.com>",
  "homepage": "https://github.com/felicityin/inversify-typeorm#readme",
  "license": "MIT",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felicityin/inversify-typeorm.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "check:ci": "biome check",
    "clean": "rimraf lib",
    "release": "npm publish --access public.",
    "prepare": "husky && npm run build",
    "prepublishOnly": "npm test",
    "version": "git add -A src",
    "postversion": "git push && git push --tags"
  },
  "bugs": {
    "url": "https://github.com/felicityin/inversify-typeorm/issues"
  },
  "peerDependencies": {
    "inversify": "^8.2.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@jest/globals": "30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "inversify": "^8.2.4",
    "jest": "30.5.2",
    "lint-staged": "13.2.3",
    "mongodb": "^7.8.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.4",
    "typeorm": "^1.1.2",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
